# Copy this file to srcs/.env and fill in the four password variables.
# Never commit the resulting srcs/.env.

# Domain
DOMAIN_NAME=yassabda.42.fr

# Host data directory (optional, defaults to /home/yassabda/data)
DATA_PATH=/home/yassabda/data

# MariaDB
MYSQL_DATABASE=wordpress
MYSQL_USER=yassabda
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# WordPress
WP_URL=https://yassabda.42.fr
WP_TITLE=Inception Website
WP_ADMIN_USER=yass
WP_ADMIN_PASSWORD=change_me
WP_ADMIN_EMAIL=yass@student.42.fr

# Additional WordPress user (editor role)
WP_USER=yassabda
WP_USER_PASSWORD=change_me
WP_USER_EMAIL=yassabda@student.42.fr
